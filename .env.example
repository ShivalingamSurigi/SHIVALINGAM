# ==============================================================================
# Jet AI - Environment Configuration Template
# "Ask Anything. In Any Language."
# ==============================================================================

# 1. SUPABASE CONFIGURATION (Database, Auth, Storage, RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. AI PROVIDER CONFIGURATION
# Options: gemini (default), openai, mock
AI_PROVIDER=gemini
AI_API_KEY=your-google-gemini-or-openai-api-key

# Optional provider-specific fallbacks
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. LIVE WEB SEARCH GROUNDING PROVIDER
# Supported: Tavily (tvly-...) or Brave Search (BSA...)
SEARCH_API_KEY=your-search-api-key

# 4. ADVANCED VOICE (TTS / STT) API (Optional - Web Speech API works natively)
VOICE_API_KEY=your-voice-provider-api-key

# 5. APPLICATION SETTINGS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
